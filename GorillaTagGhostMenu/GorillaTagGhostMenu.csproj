<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GhostedDoreto</AssemblyName>
    <RootNamespace>GhostedDoreto</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx Core -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    
    <!-- Unity Engine References -->
    <PackageReference Include="UnityEngine.CoreModule" Version="2021.3.0" />
    <PackageReference Include="UnityEngine.InputLegacyModule" Version="2021.3.0" />
    <PackageReference Include="UnityEngine.PhysicsModule" Version="2021.3.0" />
    <PackageReference Include="UnityEngine.UIModule" Version="2021.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BepInEx\plugins\GhostedDoreto\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
